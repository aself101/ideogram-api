{
  "name": "ideogram-api",
  "version": "1.1.0",
  "description": "Node.js library and CLI for the Ideogram API: image generation and editing (Ideogram 3.0, 4.x and auto), SVG, upscaling and video (MiniMax H3, Seedance 2.5)",
  "type": "module",
  "main": "dist/api.js",
  "types": "dist/api.d.ts",
  "bin": {
    "ideogram": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "verify": "tsc --noEmit && vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build",
    "ideogram": "tsx src/cli.ts",
    "ideogram:help": "tsx src/cli.ts --help",
    "ideogram:examples": "tsx src/cli.ts --examples",
    "ideogram:generate": "tsx src/cli.ts generate",
    "ideogram:edit": "tsx src/cli.ts edit",
    "ideogram:remix": "tsx src/cli.ts remix",
    "ideogram:reframe": "tsx src/cli.ts reframe",
    "ideogram:replace-background": "tsx src/cli.ts replace-background",
    "ideogram:upscale": "tsx src/cli.ts upscale",
    "ideogram:describe": "tsx src/cli.ts describe",
    "ideogram:list-styles": "tsx src/cli.ts list-style-presets",
    "ideogram:list-ratios": "tsx src/cli.ts list-aspect-ratios",
    "ideogram:list-resolutions": "tsx src/cli.ts list-resolutions"
  },
  "keywords": [
    "ideogram",
    "ai",
    "image-generation",
    "text-to-image",
    "image-to-image",
    "image-editing",
    "upscale",
    "remix",
    "reframe",
    "typescript",
    "svg",
    "vector",
    "video",
    "text-to-video",
    "image-to-video",
    "minimax",
    "seedance",
    "cli"
  ],
  "author": "img-gen Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aself101/ideogram-api.git"
  },
  "bugs": {
    "url": "https://github.com/aself101/ideogram-api/issues"
  },
  "homepage": "https://github.com/aself101/ideogram-api#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "image-size": "^2.1.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/ui": "^5.1.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
